@code {
    private bool isLoading = true;
    private string activeTab = "routines";
    private Guid selectedPersonId = Guid.Empty;

    // Data lists
    private List<PersonDto> people = new();
    private List<RoutineTaskDto> routineTasks = new();
    private List<RewardDto> rewards = new();
    private List<SubjectDto> subjects = new();
    private List<HomeworkItemDto> homeworkList = new();
    private List<ExamEventDto> exams = new();
    private List<SchoolScheduleDto> schoolSchedules = new();
    private List<SavingsGoalDto> savingsGoals = new();
    private List<PointLedgerDto> pointHistory = new();
    private KidWalletDto? kidWallet;
    private AllowanceRuleDto? allowanceRule;
    private int pointBalance = 0;

    // Approvals
    private List<RoutineCompletionDto> pendingApprovals = new();
    private List<RewardRedemptionDto> pendingRedemptions = new();
    private List<WalletRequestDto> pendingWalletRequests = new();

    // Modals state
    private bool showAddRoutineModal = false;
    private string newRoutineTitle = "";
    private RoutineTimeSlot newRoutineSlot = RoutineTimeSlot.Morning;
    private int newRoutinePoints = 10;
    private bool newRoutineRequiresApproval = true;

    private bool showAddRewardModal = false;
    private string newRewardTitle = "";
    private int newRewardCost = 20;

    private bool showAddHomeworkModal = false;
    private Guid? newHomeworkSubjectId;
    private string newSubjectName = "";
    private string newHomeworkTitle = "";
    private DateTime newHomeworkDueDate = DateTime.Today.AddDays(1);
    private string newHomeworkDetails = "";

    private bool showAddExamModal = false;
    private Guid? newExamSubjectId;
    private string newExamTopics = "";
    private DateTime newExamDate = DateTime.Today.AddDays(7);

    private bool showAddGoalModal = false;
    private string newGoalTitle = "";
    private long newGoalTargetAmount = 100_000;

    private bool showRequestWalletModal = false;
    private long requestAmount = 50_000;
    private string requestReason = "";

    private bool showHistoryModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        isLoading = true;
        try
        {
            people = await PersonService.GetPeopleAsync();
            if (people.Any())
            {
                if (selectedPersonId == Guid.Empty || !people.Any(p => p.Id == selectedPersonId))
                {
                    selectedPersonId = people.First().Id;
                }
                await LoadPersonData(selectedPersonId);
            }
            await LoadPendingParentDesk();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPersonChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var pid))
        {
            selectedPersonId = pid;
            await LoadPersonData(selectedPersonId);
        }
    }

    private async Task LoadPersonData(Guid personId)
    {
        routineTasks = (await ChildrenService.GetRoutineTasksAsync(personId)).ToList();
        rewards = (await ChildrenService.GetRewardsAsync()).ToList();
        subjects = (await ChildrenService.GetSubjectsAsync(personId)).ToList();
        homeworkList = (await ChildrenService.GetHomeworkAsync(personId)).ToList();
        exams = (await ChildrenService.GetExamsAsync(personId)).ToList();
        schoolSchedules = (await ChildrenService.GetSchoolScheduleAsync(personId)).ToList();
        savingsGoals = (await ChildrenService.GetSavingsGoalsAsync(personId)).ToList();
        pointBalance = await ChildrenService.GetPointBalanceAsync(personId);
        kidWallet = await ChildrenService.GetKidWalletAsync(personId);
        allowanceRule = await ChildrenService.GetAllowanceRuleAsync(personId);
    }

    private async Task LoadPendingParentDesk()
    {
        pendingApprovals = (await ChildrenService.GetPendingApprovalsAsync()).ToList();
        pendingRedemptions = (await ChildrenService.GetPendingRedemptionsAsync()).ToList();
        pendingWalletRequests = (await ChildrenService.GetWalletRequestsAsync(status: WalletRequestStatus.Pending)).ToList();
    }

    // Routine actions
    private async Task CompleteRoutine(Guid taskId)
    {
        await ChildrenService.CompleteRoutineTaskAsync(taskId);
        await LoadPersonData(selectedPersonId);
        await LoadPendingParentDesk();
    }

    private async Task ApproveRoutine(Guid completionId)
    {
        var parentId = UserContext.UserId ?? Guid.Empty;
        await ChildrenService.ApproveRoutineCompletionAsync(completionId, parentId);
        await LoadPersonData(selectedPersonId);
        await LoadPendingParentDesk();
    }

    private async Task RejectRoutine(Guid completionId)
    {
        var parentId = UserContext.UserId ?? Guid.Empty;
        await ChildrenService.RejectRoutineCompletionAsync(completionId, parentId);
        await LoadPendingParentDesk();
    }

    // Reward actions
    private async Task RedeemReward(Guid rewardId)
    {
        await ChildrenService.RedeemRewardAsync(rewardId, selectedPersonId);
        await LoadPersonData(selectedPersonId);
        await LoadPendingParentDesk();
    }

    private async Task ApproveRedemption(Guid redemptionId)
    {
        var parentId = UserContext.UserId ?? Guid.Empty;
        await ChildrenService.ApproveRewardRedemptionAsync(redemptionId, parentId);
        await LoadPersonData(selectedPersonId);
        await LoadPendingParentDesk();
    }

    private async Task RejectRedemption(Guid redemptionId)
    {
        var parentId = UserContext.UserId ?? Guid.Empty;
        await ChildrenService.RejectRewardRedemptionAsync(redemptionId, parentId);
        await LoadPendingParentDesk();
    }

    // Homework actions
    private async Task UpdateHomework(Guid homeworkId, HomeworkStatus status, bool parentChecked = false)
    {
        await ChildrenService.UpdateHomeworkStatusAsync(homeworkId, status, parentChecked);
        await LoadPersonData(selectedPersonId);
    }

    // Wallet actions
    private async Task ApproveWalletRequest(Guid requestId)
    {
        var parentId = UserContext.UserId ?? Guid.Empty;
        await ChildrenService.ApproveWalletRequestAsync(requestId, parentId);
        await LoadPersonData(selectedPersonId);
        await LoadPendingParentDesk();
    }

    private async Task RejectWalletRequest(Guid requestId)
    {
        var parentId = UserContext.UserId ?? Guid.Empty;
        await ChildrenService.RejectWalletRequestAsync(requestId, parentId);
        await LoadPendingParentDesk();
    }

    // Modals opener & savers
    private void OpenAddRoutineModal() => showAddRoutineModal = true;
    private async Task SaveRoutine()
    {
        if (string.IsNullOrWhiteSpace(newRoutineTitle)) return;
        await ChildrenService.CreateRoutineTaskAsync(new CreateRoutineTaskRequest(
            selectedPersonId, newRoutineTitle, Points: newRoutinePoints, TimeSlot: newRoutineSlot, RequiresApproval: newRoutineRequiresApproval));
        showAddRoutineModal = false;
        newRoutineTitle = "";
        await LoadPersonData(selectedPersonId);
    }

    private void OpenAddRewardModal() => showAddRewardModal = true;
    private async Task SaveReward()
    {
        if (string.IsNullOrWhiteSpace(newRewardTitle)) return;
        await ChildrenService.CreateRewardAsync(new CreateRewardRequest(newRewardTitle, newRewardCost));
        showAddRewardModal = false;
        newRewardTitle = "";
        await LoadPersonData(selectedPersonId);
    }

    private void OpenAddHomeworkModal() => showAddHomeworkModal = true;
    private async Task SaveHomework()
    {
        if (string.IsNullOrWhiteSpace(newHomeworkTitle)) return;
        Guid subId;
        if (!string.IsNullOrWhiteSpace(newSubjectName))
        {
            var sub = await ChildrenService.CreateSubjectAsync(new CreateSubjectRequest(selectedPersonId, newSubjectName));
            subId = sub.Id;
            newSubjectName = "";
        }
        else if (newHomeworkSubjectId.HasValue && newHomeworkSubjectId.Value != Guid.Empty)
        {
            subId = newHomeworkSubjectId.Value;
        }
        else
        {
            var defaultSub = subjects.FirstOrDefault() ?? await ChildrenService.CreateSubjectAsync(new CreateSubjectRequest(selectedPersonId, "General"));
            subId = defaultSub.Id;
        }

        await ChildrenService.CreateHomeworkAsync(new CreateHomeworkRequest(
            selectedPersonId, subId, newHomeworkTitle, DateOnly.FromDateTime(newHomeworkDueDate), newHomeworkDetails));

        showAddHomeworkModal = false;
        newHomeworkTitle = "";
        newHomeworkDetails = "";
        await LoadPersonData(selectedPersonId);
    }

    private void OpenAddExamModal() => showAddExamModal = true;
    private async Task SaveExam()
    {
        if (string.IsNullOrWhiteSpace(newExamTopics)) return;
        Guid subId = (newExamSubjectId.HasValue && newExamSubjectId.Value != Guid.Empty)
            ? newExamSubjectId.Value
            : (subjects.FirstOrDefault()?.Id ?? (await ChildrenService.CreateSubjectAsync(new CreateSubjectRequest(selectedPersonId, "General"))).Id);

        await ChildrenService.CreateExamAsync(new CreateExamEventRequest(
            selectedPersonId, subId, DateOnly.FromDateTime(newExamDate), newExamTopics));

        showAddExamModal = false;
        newExamTopics = "";
        await LoadPersonData(selectedPersonId);
    }

    private void OpenAddGoalModal() => showAddGoalModal = true;
    private async Task SaveSavingsGoal()
    {
        if (string.IsNullOrWhiteSpace(newGoalTitle)) return;
        await ChildrenService.CreateSavingsGoalAsync(new CreateSavingsGoalRequest(
            selectedPersonId, newGoalTitle, newGoalTargetAmount));
        showAddGoalModal = false;
        newGoalTitle = "";
        await LoadPersonData(selectedPersonId);
    }

    private void OpenRequestWalletModal() => showRequestWalletModal = true;
    private async Task SubmitWalletRequest()
    {
        if (requestAmount <= 0) return;
        await ChildrenService.RequestWalletActionAsync(
            selectedPersonId, WalletRequestKind.Withdrawal, requestAmount, requestReason);
        showRequestWalletModal = false;
        requestReason = "";
        await LoadPendingParentDesk();
    }

    private async Task OpenHistoryModal()
    {
        pointHistory = (await ChildrenService.GetPointHistoryAsync(selectedPersonId)).ToList();
        showHistoryModal = true;
    }

    // Helpers
    private string FormatMoney(long amount)
    {
        var raw = $"{amount:N0} IRR";
        return CalendarService.ConvertDigits(raw, Preferences.DigitStyle);
    }

    private string FormatDate(DateOnly date)
    {
        return CalendarService.FormatDate(date, "yyyy/MM/dd", Preferences.Calendar, Preferences.DigitStyle);
    }

    private string FormatDate(DateTime dt)
    {
        return CalendarService.FormatDate(DateOnly.FromDateTime(dt), "yyyy/MM/dd", Preferences.Calendar, Preferences.DigitStyle);
    }

