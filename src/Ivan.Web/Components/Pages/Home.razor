@page "/"
@rendermode InteractiveServer
@using Ivan.Application.Services
@using Ivan.Domain.Enums
@using Ivan.Web.Components.Common
@inject IDashboardService DashboardService
@inject IChildrenService ChildrenService
@inject IPersonService PersonService
@inject ICalendarService CalendarService
@inject UserPreferencesState Preferences
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(Preferences.IsRtl ? "ایوان — داشبورد خانواده" : "Ivan — Family Dashboard")</PageTitle>

<div class="container-fluid p-0">
    <!-- Header Banner -->
    <div class="card mb-4 border-0 shadow-sm" style="border-radius: 1rem; background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h3 class="fw-bold mb-1">
                        @(Preferences.IsRtl ? $"ایوان — خانه {parentData?.HouseholdName ?? "خانواده"}" : $"Ivan — {parentData?.HouseholdName ?? "Family"} Home")
                    </h3>
                    <p class="mb-0 opacity-75 small">
                        @(Preferences.IsRtl ? "مدیریت جامع کارها، دارایی‌ها، مالی، سلامت، کتابخانه و بچه‌ها" : "Unified home management for tasks, assets, money, health, library & kids")
                    </p>
                </div>
                <!-- Persona Badge & Switcher -->
                <div class="d-flex align-items-center gap-2 bg-white bg-opacity-25 px-3 py-1 rounded-pill">
                    <span class="small fw-semibold">@(Preferences.IsRtl ? "نمای جاری:" : "Current View:")</span>
                    <span class="badge bg-light text-dark fw-bold">
                        @(Preferences.ActivePersona switch
                        {
                            "Parent" => Preferences.IsRtl ? "والدین 👨‍👩‍👧‍👦" : "Parent 👨‍👩‍👧‍👦",
                            "Teen" => Preferences.IsRtl ? "نوجوان 🎧" : "Teen 🎧",
                            "Child" => Preferences.IsRtl ? "کودک 🎈" : "Child 🎈",
                            _ => Preferences.ActivePersona
                        })
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-secondary small mt-2">@(Preferences.IsRtl ? "در حال بارگذاری داشبورد..." : "Loading dashboard...")</p>
        </div>
    }
    else if (Preferences.ActivePersona == "Parent")
    {
        <!-- ================= PARENT DASHBOARD ================= -->
        <!-- Financial & Operational KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100 border-start border-4 border-primary">
                    <div class="text-secondary small mb-1">💰 @(Preferences.IsRtl ? "دارایی خالص" : "Net Worth")</div>
                    <div class="fs-4 fw-bold text-dark">
                        @FormatCurrency(parentData?.NetWorth ?? 0)
                    </div>
                    <small class="text-muted">@(Preferences.IsRtl ? "تومان" : "Toman")</small>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100 border-start border-4 border-success">
                    <div class="text-secondary small mb-1">💵 @(Preferences.IsRtl ? "موجودی نقد و بانک" : "Cash & Bank")</div>
                    <div class="fs-4 fw-bold text-success">
                        @FormatCurrency(parentData?.TotalCash ?? 0)
                    </div>
                    <small class="text-muted">@(Preferences.IsRtl ? "تومان" : "Toman")</small>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100 border-start border-4 border-warning">
                    <div class="text-secondary small mb-1">⏳ @(Preferences.IsRtl ? "تأییدیه‌های باز بچه‌ها" : "Pending Approvals")</div>
                    <div class="fs-4 fw-bold text-warning">
                        @FormatNumber((parentData?.PendingRoutineApprovals ?? 0) + (parentData?.PendingRewardRedemptions ?? 0) + (parentData?.PendingWalletRequests ?? 0))
                    </div>
                    <small class="text-muted">@(Preferences.IsRtl ? "روتین، جایزه، کیف‌پول" : "Routines, rewards, wallet")</small>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100 border-start border-4 border-danger">
                    <div class="text-secondary small mb-1">⚠️ @(Preferences.IsRtl ? "کارهای معوقه" : "Overdue Tasks")</div>
                    <div class="fs-4 fw-bold text-danger">
                        @FormatNumber(parentData?.OverdueTasksCount ?? 0)
                    </div>
                    <small class="text-muted">@(Preferences.IsRtl ? "نیازمند اقدام فوری" : "Requires attention")</small>
                </div>
            </div>
        </div>

        <!-- Quick Action Shortcuts -->
        <div class="card border-0 shadow-sm p-3 mb-4 bg-light">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span class="fw-bold small text-secondary">🚀 @(Preferences.IsRtl ? "دسترسی سریع:" : "Quick Actions:")</span>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/tasks" class="btn btn-sm btn-white bg-white border shadow-sm">✓ @(Preferences.IsRtl ? "وظایف" : "Tasks")</a>
                    <a href="/money" class="btn btn-sm btn-white bg-white border shadow-sm">💳 @(Preferences.IsRtl ? "امور مالی" : "Money")</a>
                    <a href="/assets" class="btn btn-sm btn-white bg-white border shadow-sm">📦 @(Preferences.IsRtl ? "اموال و نگهداری" : "Assets")</a>
                    <a href="/kids" class="btn btn-sm btn-white bg-white border shadow-sm">🧒 @(Preferences.IsRtl ? "بچه‌ها" : "Kids")</a>
                    <a href="/library" class="btn btn-sm btn-white bg-white border shadow-sm">📚 @(Preferences.IsRtl ? "کتاب و فیلم" : "Library")</a>
                    <a href="/settings" class="btn btn-sm btn-white bg-white border shadow-sm">💾 @(Preferences.IsRtl ? "پشتیبان‌گیری" : "Backups")</a>
                </div>
            </div>
        </div>

        <!-- Section: Due Soon (Next 7 Days) and Expiring Soon (Next 30 Days) -->
        <div class="row g-4">
            <!-- Due Soon -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            ⏰ @(Preferences.IsRtl ? "سررسیدهای ۷ روز آینده" : "Due Soon (Next 7 Days)")
                        </h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary">
                            @FormatNumber(parentData?.DueSoonItems.Count ?? 0)
                        </span>
                    </div>

                    @if (parentData?.DueSoonItems.Count == 0)
                    {
                        <div class="alert alert-light text-center border p-4 text-muted small my-auto">
                            🎉 @(Preferences.IsRtl ? "هیچ سررسیدی برای ۷ روز آینده وجود ندارد!" : "Nothing due in the next 7 days.")
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in parentData!.DueSoonItems)
                            {
                                <a href="@item.Url" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2">
                                    <div>
                                        <div class="fw-bold small text-dark">@item.Title</div>
                                        @if (!string.IsNullOrEmpty(item.Details))
                                        {
                                            <small class="text-secondary d-block">@item.Details</small>
                                        }
                                        <small class="text-muted" style="font-size: 0.75rem;">
                                            @CalendarService.FormatDate(DateOnly.FromDateTime(item.DueAt.LocalDateTime), "yyyy/MM/dd", Preferences.Calendar, Preferences.DigitStyle)
                                        </small>
                                    </div>
                                    <span class="badge bg-@(item.Severity == "danger" ? "danger" : item.Severity == "warning" ? "warning text-dark" : "info text-dark")">
                                        @item.Module
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Expiring Soon -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            🛡️ @(Preferences.IsRtl ? "انقضاهای ۳۰ روز آینده (مدارک و گارانتی‌ها)" : "Expiring Soon (Next 30 Days)")
                        </h6>
                        <span class="badge bg-danger-subtle text-danger border border-danger">
                            @FormatNumber(parentData?.ExpiringItems.Count ?? 0)
                        </span>
                    </div>

                    @if (parentData?.ExpiringItems.Count == 0)
                    {
                        <div class="alert alert-light text-center border p-4 text-muted small my-auto">
                            ✓ @(Preferences.IsRtl ? "هیچ مدرک یا گارانتی منقضی‌شونده‌ای در ۳۰ روز آتی ثبت نشده است." : "No documents or warranties expiring in the next 30 days.")
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var exp in parentData!.ExpiringItems)
                            {
                                <a href="@exp.Url" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2">
                                    <div>
                                        <div class="fw-bold small text-dark">@exp.Title</div>
                                        @if (!string.IsNullOrEmpty(exp.Details))
                                        {
                                            <small class="text-secondary d-block">@exp.Details</small>
                                        }
                                        <small class="text-danger fw-semibold" style="font-size: 0.75rem;">
                                            @(Preferences.IsRtl ? "موعد انقضا:" : "Expires:")
                                            @CalendarService.FormatDate(DateOnly.FromDateTime(exp.DueAt.LocalDateTime), "yyyy/MM/dd", Preferences.Calendar, Preferences.DigitStyle)
                                        </small>
                                    </div>
                                    <span class="badge bg-light text-danger border border-danger">@exp.Module</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Preferences.ActivePersona == "Teen")
    {
        <!-- ================= TEEN DASHBOARD ================= -->
        <!-- Teen selector if available -->
        @if (familyMembers.Count > 1)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <label class="small fw-bold">@(Preferences.IsRtl ? "انتخاب پروفایل:" : "Select Profile:")</label>
                <select class="form-select form-select-sm w-auto" value="@selectedPersonId" @onchange="OnPersonSelected">
                    @foreach (var m in familyMembers)
                    {
                        <option value="@m.Id">@m.DisplayName</option>
                    }
                </select>
            </div>
        }

        <!-- Teen KPIs -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100 border-start border-4 border-info">
                    <div class="text-secondary small mb-1">💳 @(Preferences.IsRtl ? "موجودی کیف پول من" : "My Wallet")</div>
                    <div class="fs-4 fw-bold text-dark">@FormatCurrency(teenData?.WalletBalance ?? 0)</div>
                    <small class="text-muted">@(Preferences.IsRtl ? "تومان" : "Toman")</small>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100 border-start border-4 border-success">
                    <div class="text-secondary small mb-1">🎯 @(Preferences.IsRtl ? "پیشرفت هدف پس‌انداز" : "Savings Goal")</div>
                    <div class="fs-4 fw-bold text-success">@FormatNumber((long)(teenData?.SavingsGoalProgress ?? 0))%</div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: @Math.Min(100, (teenData?.SavingsGoalProgress ?? 0))%;"></div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100 border-start border-4 border-warning">
                    <div class="text-secondary small mb-1">📝 @(Preferences.IsRtl ? "تکالیف در دست اقدام" : "Homework")</div>
                    <div class="fs-4 fw-bold text-warning">@FormatNumber(teenData?.PendingHomeworkCount ?? 0)</div>
                    <small class="text-muted">@(Preferences.IsRtl ? "درس‌های مدرسه" : "School assignments")</small>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100 border-start border-4 border-primary">
                    <div class="text-secondary small mb-1">🔄 @(Preferences.IsRtl ? "روتین‌های امروز" : "Today's Routines")</div>
                    <div class="fs-4 fw-bold text-primary">
                        @FormatNumber(teenData?.TodayCompletedRoutines ?? 0) / @FormatNumber(teenData?.TodayRoutinesCount ?? 0)
                    </div>
                    <small class="text-muted">@(Preferences.IsRtl ? "تکمیل شده" : "Completed")</small>
                </div>
            </div>
        </div>

        <!-- Next to watch episode banner -->
        @if (!string.IsNullOrEmpty(teenData?.NextWatchMediaTitle))
        {
            <div class="card border-0 shadow-sm p-3 mb-4 bg-light border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <span class="badge bg-primary mb-1">🎬 @(Preferences.IsRtl ? "بعدش چی ببینم؟" : "Next to Watch")</span>
                        <h6 class="fw-bold mb-0 text-dark">@teenData.NextWatchMediaTitle</h6>
                        <small class="text-secondary">@teenData.NextWatchEpisodeInfo</small>
                    </div>
                    <a href="/library" class="btn btn-outline-primary btn-sm fw-bold">
                        ▶ @(Preferences.IsRtl ? "مشاهده در ماژول مدیا" : "Open in Media")
                    </a>
                </div>
            </div>
        }

        <!-- Routines checklist & My dues -->
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0">✓ @(Preferences.IsRtl ? "چک‌لیست روتین‌های روزانه من" : "My Daily Routines")</h6>
                        <span class="badge bg-light text-dark border">
                            @FormatNumber(todayRoutinesList.Count(r => r.IsCompletedToday)) / @FormatNumber(todayRoutinesList.Count)
                        </span>
                    </div>

                    @if (todayRoutinesList.Count == 0)
                    {
                        <div class="alert alert-light text-center border p-4 text-muted small my-auto">
                            @(Preferences.IsRtl ? "هیچ روتینی برای امروز تنظیم نشده است." : "No routines scheduled for today.")
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var r in todayRoutinesList)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">@(r.IsCompletedToday ? "✅" : "⭕")</span>
                                        <div>
                                            <div class="fw-bold small @(r.IsCompletedToday ? "text-decoration-line-through text-muted" : "text-dark")">@r.Title</div>
                                            <small class="text-secondary">⭐ +@FormatNumber(r.Points) @(Preferences.IsRtl ? "امتیاز" : "pts")</small>
                                        </div>
                                    </div>
                                    @if (!r.IsCompletedToday)
                                    {
                                        <button class="btn btn-sm btn-outline-success fw-bold" @onclick="() => CompleteRoutineAsync(r.Id)">
                                            ✓ @(Preferences.IsRtl ? "انجام شد" : "Done")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">
                                            @(Preferences.IsRtl ? "ثبت شد" : "Completed")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0">📅 @(Preferences.IsRtl ? "تکالیف و موعدهای نزدیک من" : "Upcoming Deadlines")</h6>
                        <span class="badge bg-warning-subtle text-warning border border-warning">
                            @FormatNumber(teenData?.MyDueItems.Count ?? 0)
                        </span>
                    </div>

                    @if (teenData?.MyDueItems.Count == 0)
                    {
                        <div class="alert alert-light text-center border p-4 text-muted small my-auto">
                            🎉 @(Preferences.IsRtl ? "تمام تکالیف انجام شده و موعد نزدیکی نداری!" : "All caught up! No upcoming deadlines.")
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var d in teenData!.MyDueItems)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-2">
                                    <div>
                                        <div class="fw-bold small text-dark">@d.Title</div>
                                        @if (!string.IsNullOrEmpty(d.Details))
                                        {
                                            <small class="text-secondary d-block">@d.Details</small>
                                        }
                                        <small class="text-muted" style="font-size: 0.75rem;">
                                            @CalendarService.FormatDate(DateOnly.FromDateTime(d.DueAt.LocalDateTime), "yyyy/MM/dd", Preferences.Calendar, Preferences.DigitStyle)
                                        </small>
                                    </div>
                                    <span class="badge bg-light text-dark border">@d.Module</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Preferences.ActivePersona == "Child")
    {
        <!-- ================= CHILD DASHBOARD ================= -->
        <!-- Child selector if available -->
        @if (familyMembers.Count > 1)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <label class="small fw-bold">@(Preferences.IsRtl ? "انتخاب کودک:" : "Select Child:")</label>
                <select class="form-select form-select-sm w-auto" value="@selectedPersonId" @onchange="OnPersonSelected">
                    @foreach (var m in familyMembers)
                    {
                        <option value="@m.Id">@m.DisplayName</option>
                    }
                </select>
            </div>
        }

        <!-- Celebratory Feedback Alert if clicked -->
        @if (showCelebration)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm p-3 mb-4 text-center" style="border-radius: 1rem; background-color: #d1fae5;">
                <div class="fs-2 mb-1">🎉 🌟 👏</div>
                <h5 class="fw-bold text-success mb-1">@(Preferences.IsRtl ? "آفرین قهرمان! کارت عالی بود!" : "Awesome Job, Champ!")</h5>
                <p class="mb-0 text-dark small">@(Preferences.IsRtl ? "ستاره‌های این کار به حساب تو اضافه شد!" : "Stars have been added to your balance!")</p>
                <button type="button" class="btn-close" @onclick="() => showCelebration = false"></button>
            </div>
        }

        <!-- Star Scoreboard Banner -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-4 text-center h-100" style="border-radius: 1.25rem; background: linear-gradient(135deg, #fef3c7 0%, #fde047 100%);">
                    <div style="font-size: 3rem;">⭐</div>
                    <h2 class="fw-bold text-dark mb-1">
                        @FormatNumber(childData?.StarsBalance ?? 0)
                    </h2>
                    <div class="fw-bold text-secondary">
                        @(Preferences.IsRtl ? "ستاره درخشان داری!" : "Shiny Stars!")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-4 text-center h-100" style="border-radius: 1.25rem; background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);">
                    <div style="font-size: 3rem;">🐷</div>
                    <h2 class="fw-bold text-dark mb-1">
                        @FormatCurrency(childData?.PiggyBankBalance ?? 0)
                    </h2>
                    <div class="fw-bold text-secondary">
                        @(Preferences.IsRtl ? "تومان در قلک تو ذخیره شده!" : "Toman in your Piggy Bank!")
                    </div>
                </div>
            </div>
        </div>

        <!-- Today's Routine Checklist Cards for Child -->
        <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 1rem;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0">🎯 @(Preferences.IsRtl ? "کارهای امروز من" : "My Tasks for Today")</h5>
                <span class="badge bg-light text-dark border fs-6">
                    @FormatNumber(childData?.TodayCompletedRoutines ?? 0) / @FormatNumber(childData?.TodayTotalRoutines ?? 0)
                </span>
            </div>

            @if (childData?.TodayRoutines.Count == 0)
            {
                <div class="alert alert-light text-center border p-4 text-muted my-3">
                    🎈 @(Preferences.IsRtl ? "امروز هیچ کاری ثبت نشده، روزت شاد و خوش بگذره!" : "No tasks for today. Have fun!")
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var routine in childData!.TodayRoutines)
                    {
                        <div class="col-sm-6 col-md-4">
                            <div class="card h-100 border-2 @(routine.IsCompletedToday ? "border-success bg-success-subtle bg-opacity-25" : "border-primary") p-3 text-center" style="border-radius: 1rem;">
                                <div style="font-size: 2.2rem;" class="mb-2">
                                    @(routine.IsCompletedToday ? "🌟" : "🎯")
                                </div>
                                <h6 class="fw-bold text-dark mb-1">@routine.Title</h6>
                                <div class="badge bg-warning text-dark mb-3">
                                    +@FormatNumber(routine.Points) ⭐
                                </div>
                                <div>
                                    @if (routine.IsCompletedToday)
                                    {
                                        <button class="btn btn-success btn-sm w-100 fw-bold disabled">
                                            ✓ @(Preferences.IsRtl ? "آفرین! انجام شد" : "Done!")
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary btn-sm w-100 fw-bold py-2 shadow-sm" @onclick="() => CompleteChildRoutineAsync(routine.Id)">
                                            🎉 @(Preferences.IsRtl ? "انجام دادم!" : "I Did It!")
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Affordable Rewards Store -->
        @if (childData?.AffordableRewards.Count > 0)
        {
            <div class="card border-0 shadow-sm p-3" style="border-radius: 1rem;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0">🎁 @(Preferences.IsRtl ? "جوایزی که همین الان می‌تونی بگیری!" : "Rewards You Can Get Now!")</h5>
                    <a href="/kids" class="small text-decoration-none">@(Preferences.IsRtl ? "فروشگاه کامل" : "Reward Store")</a>
                </div>

                <div class="row g-3">
                    @foreach (var reward in childData.AffordableRewards)
                    {
                        <div class="col-sm-6 col-md-3">
                            <div class="card h-100 border p-3 text-center bg-light" style="border-radius: 0.75rem;">
                                <div style="font-size: 2rem;" class="mb-1">🎁</div>
                                <div class="fw-bold text-dark small mb-1">@reward.Title</div>
                                <div class="badge bg-secondary mb-3">@FormatNumber(reward.Cost) ⭐</div>
                                <button class="btn btn-outline-primary btn-sm fw-bold w-100" @onclick="() => RedeemChildRewardAsync(reward.Id)">
                                    🎁 @(Preferences.IsRtl ? "دریافت جایزه" : "Redeem")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private bool showCelebration = false;

    private ParentDashboardDto? parentData;
    private TeenDashboardDto? teenData;
    private ChildDashboardDto? childData;

    private List<PersonDto> familyMembers = new();
    private Guid selectedPersonId = Guid.Empty;
    private List<RoutineTaskDto> todayRoutinesList = new();

    protected override async Task OnInitializedAsync()
    {
        Preferences.OnChange += HandlePreferencesChanged;
        await LoadDashboardAsync();
    }

    public void Dispose()
    {
        Preferences.OnChange -= HandlePreferencesChanged;
    }

    private async void HandlePreferencesChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDashboardAsync();
            StateHasChanged();
        });
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        try
        {
            familyMembers = await PersonService.GetPeopleAsync();
            if (selectedPersonId == Guid.Empty && familyMembers.Count > 0)
            {
                selectedPersonId = familyMembers[0].Id;
            }

            if (Preferences.ActivePersona == "Parent")
            {
                parentData = await DashboardService.GetParentDashboardAsync();
            }
            else if (Preferences.ActivePersona == "Teen")
            {
                teenData = await DashboardService.GetTeenDashboardAsync(selectedPersonId);
                var today = DateOnly.FromDateTime(DateTime.UtcNow);
                var list = await ChildrenService.GetRoutineTasksAsync(selectedPersonId, today);
                todayRoutinesList = list.ToList();
            }
            else if (Preferences.ActivePersona == "Child")
            {
                childData = await DashboardService.GetChildDashboardAsync(selectedPersonId);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPersonSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var pid))
        {
            selectedPersonId = pid;
            await LoadDashboardAsync();
        }
    }

    private async Task CompleteRoutineAsync(Guid routineTaskId)
    {
        try
        {
            await ChildrenService.CompleteRoutineTaskAsync(routineTaskId);
            NotificationService.Notify(NotificationSeverity.Success, Preferences.IsRtl ? "ثبت شد" : "Done",
                Preferences.IsRtl ? "روتین با موفقیت ثبت شد." : "Routine marked as completed.");
            await LoadDashboardAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
    }

    private async Task CompleteChildRoutineAsync(Guid routineTaskId)
    {
        try
        {
            await ChildrenService.CompleteRoutineTaskAsync(routineTaskId);
            showCelebration = true;
            await LoadDashboardAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
    }

    private async Task RedeemChildRewardAsync(Guid rewardId)
    {
        try
        {
            await ChildrenService.RedeemRewardAsync(rewardId, selectedPersonId);
            NotificationService.Notify(NotificationSeverity.Success, Preferences.IsRtl ? "درخواست جایزه" : "Reward Request",
                Preferences.IsRtl ? "درخواست جایزه برای تایید والدین ارسال شد! 🎉" : "Reward requested! Sent for parent approval.");
            await LoadDashboardAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
    }

    private string FormatCurrency(long amount) =>
        CalendarService.ConvertDigits(amount.ToString("N0"), Preferences.DigitStyle);

    private string FormatNumber(long number) =>
        CalendarService.ConvertDigits(number.ToString("N0"), Preferences.DigitStyle);
}
