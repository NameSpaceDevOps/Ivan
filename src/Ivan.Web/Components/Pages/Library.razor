@code {
    private bool isLoading = true;
    private string activeTab = "books";
    private Guid selectedPersonId = Guid.Empty;

    // Filters
    private string bookSearch = "";
    private BookStatus? selectedBookStatus;
    private Guid? selectedBookSpaceId;

    private string mediaSearch = "";
    private MediaType? selectedMediaType;
    private WatchStatus? selectedWatchStatus;

    // Data lists
    private List<PersonDto> people = new();
    private List<Space> spaces = new();
    private List<BookDto> books = new();
    private List<BookLoanDto> activeLoans = new();
    private List<MediaItemDto> mediaList = new();

    // Series episode tracker state
    private MediaItemDto? selectedSeries;
    private List<MediaEpisodeDto> seriesEpisodes = new();
    private MediaEpisodeDto? selectedSeriesNextToWatch;
    private int selectedSeriesWatchedCount = 0;

    // Modals state
    private bool showAddBookModal = false;
    private string newBookTitle = "";
    private string newBookAuthor = "";
    private string? newBookTranslator;
    private string? newBookPublisher;
    private string? newBookIsbn;
    private int? newBookPageCount;
    private Guid? newBookSpaceId;
    private string? newBookShelfLocation;

    private bool showLoanModal = false;
    private BookDto? selectedBookToLoan;
    private string loanBorrowerName = "";
    private string? loanBorrowerContact;
    private DateTime loanDueDate = DateTime.Today.AddDays(14);

    private bool showSetReadModal = false;
    private BookDto? selectedBookForProgress;
    private ReadStatus newReadStatus = ReadStatus.Reading;
    private int? newCurrentPage;
    private int? newReadRating;
    private string? newReadReview;

    private bool showAddMediaModal = false;
    private string newMediaTitle = "";
    private MediaType newMediaType = MediaType.Movie;
    private string? newMediaDirector;
    private int? newMediaReleaseYear = DateTime.Today.Year;
    private string? newMediaOverview;

    private bool showSetMediaProgressModal = false;
    private MediaItemDto? selectedMediaForProgress;
    private WatchStatus newWatchStatus = WatchStatus.Watching;
    private int? newWatchRating;
    private string? newWatchReview;

    private bool showGenerateEpisodesModal = false;
    private int generateSeasonCount = 1;
    private int generateEpisodesPerSeason = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        isLoading = true;
        try
        {
            people = await PersonService.GetPeopleAsync();
            if (people.Any() && selectedPersonId == Guid.Empty)
            {
                selectedPersonId = people.First().Id;
            }

            var props = await PropertyService.GetPropertiesAsync();
            spaces = props.SelectMany(p => p.Spaces).ToList();

            await LoadBooksData();
            await LoadLoansData();
            await LoadMediaData();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPersonChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var pid))
        {
            selectedPersonId = pid;
            await LoadBooksData();
            await LoadMediaData();
            if (selectedSeries != null)
            {
                await LoadEpisodesData(selectedSeries.Id);
            }
        }
    }

    private async Task LoadBooksData()
    {
        books = (await LibraryService.GetBooksAsync(
            search: string.IsNullOrWhiteSpace(bookSearch) ? null : bookSearch,
            status: selectedBookStatus,
            spaceId: selectedBookSpaceId)).ToList();
    }

    private async Task LoadLoansData()
    {
        activeLoans = (await LibraryService.GetWhoHasWhatAsync()).ToList();
    }

    private async Task LoadMediaData()
    {
        mediaList = (await MediaService.GetMediaItemsAsync(
            search: string.IsNullOrWhiteSpace(mediaSearch) ? null : mediaSearch,
            type: selectedMediaType,
            status: selectedWatchStatus,
            personId: selectedPersonId)).ToList();
    }

    private async Task FilterBooks()
    {
        await LoadBooksData();
    }

    private async Task FilterMedia()
    {
        await LoadMediaData();
    }

    // Book Actions
    private void OpenAddBookModal()
    {
        newBookTitle = "";
        newBookAuthor = "";
        newBookTranslator = null;
        newBookPublisher = null;
        newBookIsbn = null;
        newBookPageCount = null;
        newBookSpaceId = null;
        newBookShelfLocation = null;
        showAddBookModal = true;
    }

    private async Task SaveBook()
    {
        if (string.IsNullOrWhiteSpace(newBookTitle) || string.IsNullOrWhiteSpace(newBookAuthor)) return;

        await LibraryService.CreateBookAsync(new CreateBookRequest(
            Title: newBookTitle,
            Author: newBookAuthor,
            Translator: newBookTranslator,
            Publisher: newBookPublisher,
            Isbn: newBookIsbn,
            PageCount: newBookPageCount,
            SpaceId: newBookSpaceId,
            ShelfLocation: newBookShelfLocation));

        showAddBookModal = false;
        await LoadBooksData();
    }

    private async Task DeleteBook(Guid id)
    {
        await LibraryService.DeleteBookAsync(id);
        await LoadBooksData();
        await LoadLoansData();
    }

    private void OpenLoanModal(BookDto book)
    {
        selectedBookToLoan = book;
        loanBorrowerName = "";
        loanBorrowerContact = null;
        loanDueDate = DateTime.Today.AddDays(14);
        showLoanModal = true;
    }

    private async Task SubmitLoan()
    {
        if (selectedBookToLoan == null || string.IsNullOrWhiteSpace(loanBorrowerName)) return;

        await LibraryService.LoanBookAsync(new CreateBookLoanRequest(
            BookId: selectedBookToLoan.Id,
            BorrowerName: loanBorrowerName,
            BorrowerContact: loanBorrowerContact,
            DueAt: DateOnly.FromDateTime(loanDueDate)));

        showLoanModal = false;
        await LoadBooksData();
        await LoadLoansData();
    }

    private async Task ReturnBook(Guid loanId)
    {
        await LibraryService.ReturnBookAsync(loanId);
        await LoadBooksData();
        await LoadLoansData();
    }

    private void OpenSetReadModal(BookDto book)
    {
        selectedBookForProgress = book;
        var p = book.ReadProgresses.FirstOrDefault(r => r.PersonId == selectedPersonId);
        if (p != null)
        {
            newReadStatus = p.Status;
            newCurrentPage = p.CurrentPage;
            newReadRating = p.Rating;
            newReadReview = p.Review;
        }
        else
        {
            newReadStatus = ReadStatus.Reading;
            newCurrentPage = null;
            newReadRating = null;
            newReadReview = null;
        }
        showSetReadModal = true;
    }

    private async Task SaveReadProgress()
    {
        if (selectedBookForProgress == null) return;

        await LibraryService.SetReadProgressAsync(new SetReadProgressRequest(
            BookId: selectedBookForProgress.Id,
            PersonId: selectedPersonId,
            Status: newReadStatus,
            CurrentPage: newCurrentPage,
            Rating: newReadRating,
            Review: newReadReview));

        showSetReadModal = false;
        await LoadBooksData();
    }

    // Media Actions
    private void OpenAddMediaModal()
    {
        newMediaTitle = "";
        newMediaType = MediaType.Movie;
        newMediaDirector = null;
        newMediaReleaseYear = DateTime.Today.Year;
        newMediaOverview = null;
        showAddMediaModal = true;
    }

    private async Task SaveMedia()
    {
        if (string.IsNullOrWhiteSpace(newMediaTitle)) return;

        await MediaService.CreateMediaItemAsync(new CreateMediaItemRequest(
            Title: newMediaTitle,
            Type: newMediaType,
            Director: newMediaDirector,
            ReleaseYear: newMediaReleaseYear,
            Overview: newMediaOverview));

        showAddMediaModal = false;
        await LoadMediaData();
    }

    private async Task DeleteMedia(Guid id)
    {
        await MediaService.DeleteMediaItemAsync(id);
        if (selectedSeries?.Id == id) selectedSeries = null;
        await LoadMediaData();
    }

    private void OpenSetMediaProgressModal(MediaItemDto media)
    {
        selectedMediaForProgress = media;
        var p = media.PersonProgresses.FirstOrDefault(r => r.PersonId == selectedPersonId);
        if (p != null)
        {
            newWatchStatus = p.WatchStatus;
            newWatchRating = p.Rating;
            newWatchReview = p.Review;
        }
        else
        {
            newWatchStatus = WatchStatus.Watching;
            newWatchRating = null;
            newWatchReview = null;
        }
        showSetMediaProgressModal = true;
    }

    private async Task SaveMediaProgress()
    {
        if (selectedMediaForProgress == null) return;

        await MediaService.SetPersonProgressAsync(new SetMediaProgressRequest(
            MediaItemId: selectedMediaForProgress.Id,
            PersonId: selectedPersonId,
            WatchStatus: newWatchStatus,
            Rating: newWatchRating,
            Review: newWatchReview));

        showSetMediaProgressModal = false;
        await LoadMediaData();
    }

    // Episodes Actions
    private async Task SelectSeriesForEpisodes(MediaItemDto series)
    {
        selectedSeries = series;
        activeTab = "episodes";
        await LoadEpisodesData(series.Id);
    }

    private async Task LoadEpisodesData(Guid seriesId)
    {
        seriesEpisodes = (await MediaService.GetEpisodesAsync(seriesId, personId: selectedPersonId)).ToList();
        selectedSeriesNextToWatch = await MediaService.GetNextToWatchAsync(seriesId, selectedPersonId);
        selectedSeriesWatchedCount = seriesEpisodes.Count(e => e.IsWatchedByCurrentPerson);
    }

    private async Task MarkEpisodeWatched(Guid episodeId, bool isWatched)
    {
        await MediaService.SetEpisodeWatchedAsync(new SetEpisodeWatchedRequest(episodeId, selectedPersonId, isWatched));
        if (selectedSeries != null)
        {
            await LoadEpisodesData(selectedSeries.Id);
        }
        await LoadMediaData();
    }

    private void OpenGenerateEpisodesModal()
    {
        generateSeasonCount = selectedSeries?.SeasonCount ?? 1;
        generateEpisodesPerSeason = 10;
        showGenerateEpisodesModal = true;
    }

    private async Task SubmitGenerateEpisodes()
    {
        if (selectedSeries == null || generateSeasonCount < 1 || generateEpisodesPerSeason < 1) return;

        await MediaService.GenerateEpisodesAsync(new GenerateEpisodesRequest(
            selectedSeries.Id, generateSeasonCount, generateEpisodesPerSeason));

        showGenerateEpisodesModal = false;
        await LoadEpisodesData(selectedSeries.Id);
        await LoadMediaData();
    }

    // Helpers
    private string FormatDate(DateOnly date)
    {
        return CalendarService.FormatDate(date, "yyyy/MM/dd", Preferences.Calendar, Preferences.DigitStyle);
    }

    private static string GetBookStatusBadge(BookStatus status) => status switch
    {
        BookStatus.Available => "bg-success",
        BookStatus.Loaned => "bg-warning text-dark",
        BookStatus.Wishlist => "bg-info text-white",
        _ => "bg-secondary"
    };

    private string GetBookStatusText(BookStatus status) => status switch
    {
        BookStatus.Available => Preferences.IsRtl ? "موجود در قفسه" : "Available",
        BookStatus.Loaned => Preferences.IsRtl ? "امانت داده شده" : "Loaned",
        BookStatus.Wishlist => Preferences.IsRtl ? "لیست علاقه‌مندی" : "Wishlist",
        _ => ""
    };

    private static string GetReadStatusBadge(ReadStatus status) => status switch
    {
        ReadStatus.WantToRead => "bg-secondary",
        ReadStatus.Reading => "bg-primary",
        ReadStatus.Finished => "bg-success",
        ReadStatus.Abandoned => "bg-dark",
        _ => "bg-secondary"
    };

    private string GetReadStatusText(ReadStatus status) => status switch
    {
        ReadStatus.WantToRead => Preferences.IsRtl ? "می‌خواهم بخوانم" : "Want to Read",
        ReadStatus.Reading => Preferences.IsRtl ? "در حال خواندن" : "Reading",
        ReadStatus.Finished => Preferences.IsRtl ? "خوانده شده" : "Finished",
        ReadStatus.Abandoned => Preferences.IsRtl ? "رها شده" : "Abandoned",
        _ => ""
    };

    private static string GetWatchStatusBadge(WatchStatus status) => status switch
    {
        WatchStatus.PlanToWatch => "bg-secondary",
        WatchStatus.Watching => "bg-primary",
        WatchStatus.Completed => "bg-success",
        WatchStatus.Dropped => "bg-dark",
        _ => "bg-secondary"
    };

    private string GetWatchStatusText(WatchStatus status) => status switch
    {
        WatchStatus.PlanToWatch => Preferences.IsRtl ? "قصدم تماشا است" : "Plan to Watch",
        WatchStatus.Watching => Preferences.IsRtl ? "در حال تماشا" : "Watching",
        WatchStatus.Completed => Preferences.IsRtl ? "دیده‌ام (کامل)" : "Completed",
        WatchStatus.Dropped => Preferences.IsRtl ? "رها شده" : "Dropped",
        _ => ""
    };
}
