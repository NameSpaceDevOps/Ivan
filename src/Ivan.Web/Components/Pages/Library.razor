@page "/library"
@rendermode InteractiveServer
@inject ILibraryService LibraryService
@inject IMediaService MediaService
@inject IPersonService PersonService
@inject IPropertyService PropertyService
@inject ICalendarService CalendarService
@inject UserPreferencesState Preferences
@using Ivan.Domain.Entities

<PageTitle>@(Preferences.IsRtl ? "کتابخانه و رسانه — ایوان" : "Library & Media — Ivan")</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1">@(Preferences.IsRtl ? "کتابخانه و رسانه" : "Library & Media")</h4>
            <p class="text-secondary small mb-0">@(Preferences.IsRtl ? "کتاب‌ها، وضعیت مطالعه، امانت‌ها، فیلم‌ها و سریال‌ها، و رهگیری قسمت‌ها" : "Books, reading status, loans, movies, series and episode tracking")</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="OpenAddBookModal">
                <span>+</span>
                <span>@(Preferences.IsRtl ? "کتاب جدید" : "Add Book")</span>
            </button>
            <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" @onclick="OpenAddMediaModal">
                <span>+</span>
                <span>@(Preferences.IsRtl ? "فیلم یا سریال جدید" : "Add Media")</span>
            </button>
        </div>
    </div>

    <!-- Active Person Filter Bar -->
    <div class="card border-0 shadow-sm p-3 mb-3 bg-white">
        <div class="row align-items-center g-2">
            <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">@(Preferences.IsRtl ? "عضو فعال برای وضعیت مطالعه و تماشا:" : "Active Person for Progress:")</label>
                <select class="form-select form-select-sm" value="@selectedPersonId" @onchange="OnPersonChanged">
                    @foreach (var p in people)
                    {
                        <option value="@p.Id">@p.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-8">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end align-items-center">
                    <div class="badge bg-primary p-2 fs-6 d-flex align-items-center gap-1 shadow-sm">
                        <span>📚</span>
                        <span>@books.Count @(Preferences.IsRtl ? "جلد کتاب" : "Books")</span>
                    </div>
                    <div class="badge bg-warning text-dark p-2 fs-6 d-flex align-items-center gap-1 shadow-sm">
                        <span>🤝</span>
                        <span>@activeLoans.Count @(Preferences.IsRtl ? "امانت داده شده" : "Active Loans")</span>
                    </div>
                    <div class="badge bg-info text-white p-2 fs-6 d-flex align-items-center gap-1 shadow-sm">
                        <span>🎬</span>
                        <span>@mediaList.Count @(Preferences.IsRtl ? "فیلم و سریال" : "Media Items")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-3 gap-2">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "books" ? "active" : "")" @onclick='() => activeTab = "books"'>
                📚 @(Preferences.IsRtl ? "کتاب‌ها" : "Books") (@books.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "loans" ? "active" : "") position-relative" @onclick='() => activeTab = "loans"'>
                🤝 @(Preferences.IsRtl ? "امانت‌ها و دست کیه؟" : "Who Has What")
                @if (activeLoans.Any(l => l.IsOverdue))
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        !
                    </span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "media" ? "active" : "")" @onclick='() => activeTab = "media"'>
                🎬 @(Preferences.IsRtl ? "فیلم‌ها و سریال‌ها" : "Movies & Series") (@mediaList.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "episodes" ? "active" : "")" @onclick='() => activeTab = "episodes"'>
                📺 @(Preferences.IsRtl ? "رهگیری قسمت‌ها" : "Episode Tracker")
            </button>
        </li>
    </ul>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">@(Preferences.IsRtl ? "در حال بارگذاری..." : "Loading...")</p>
        </div>
    }
    else
    {
        <!-- TAB 1: BOOKS -->
        @if (activeTab == "books")
        {
            <div class="card border-0 shadow-sm p-3 mb-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="@(Preferences.IsRtl ? "جستجوی کتاب، نویسنده، شابک (ISBN)..." : "Search title, author, ISBN...")"
                               @bind="bookSearch"
                               @bind:event="oninput"
                               @bind:after="FilterBooks" />
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select form-select-sm" @bind="selectedBookStatus" @bind:after="FilterBooks">
                            <option value="">-- @(Preferences.IsRtl ? "همه وضعیت‌ها" : "All Statuses") --</option>
                            <option value="@BookStatus.Available">@(Preferences.IsRtl ? "موجود" : "Available")</option>
                            <option value="@BookStatus.Loaned">@(Preferences.IsRtl ? "امانت داده شده" : "Loaned")</option>
                            <option value="@BookStatus.Wishlist">@(Preferences.IsRtl ? "لیست علاقه‌مندی" : "Wishlist")</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select form-select-sm" @bind="selectedBookSpaceId" @bind:after="FilterBooks">
                            <option value="">-- @(Preferences.IsRtl ? "همه مکان‌ها" : "All Spaces") --</option>
                            @foreach (var sp in spaces)
                            {
                                <option value="@sp.Id">@sp.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            @if (!books.Any())
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <span style="font-size: 3rem;">📖</span>
                    <h6 class="mt-2">@(Preferences.IsRtl ? "کتابی یافت نشد" : "No books found")</h6>
                    <p class="text-muted small">@(Preferences.IsRtl ? "کتاب‌های کتابخانه خانه را اضافه کنید." : "Add books to your family library.")</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var b in books)
                    {
                        var userProgress = b.ReadProgresses.FirstOrDefault(p => p.PersonId == selectedPersonId);
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm p-3 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex gap-2 align-items-center">
                                            <span class="fs-3">📖</span>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">@b.Title</h6>
                                                <small class="text-muted">@b.Author</small>
                                            </div>
                                        </div>
                                        <span class="badge @GetBookStatusBadge(b.Status)">@GetBookStatusText(b.Status)</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(b.Isbn))
                                    {
                                        <small class="text-secondary d-block mb-1">
                                            <strong>ISBN:</strong> @b.Isbn
                                        </small>
                                    }

                                    @if (!string.IsNullOrEmpty(b.SpaceName) || !string.IsNullOrEmpty(b.ShelfLocation))
                                    {
                                        <small class="text-secondary d-block mb-2">
                                            📍 @b.SpaceName @(!string.IsNullOrEmpty(b.ShelfLocation) ? $"({b.ShelfLocation})" : "")
                                        </small>
                                    }

                                    <!-- User Read Status Badge -->
                                    <div class="bg-light p-2 rounded mb-2 d-flex justify-content-between align-items-center">
                                        <small class="text-muted">@(Preferences.IsRtl ? "وضعیت خواندن:" : "Reading:")</small>
                                        @if (userProgress != null)
                                        {
                                            <span class="badge @GetReadStatusBadge(userProgress.Status)">@GetReadStatusText(userProgress.Status)</span>
                                        }
                                        else
                                        {
                                            <small class="text-muted">@(Preferences.IsRtl ? "ثبت نشده" : "Not set")</small>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top">
                                    <button class="btn btn-outline-primary btn-sm flex-fill" @onclick="() => OpenSetReadModal(b)">
                                        🔖 @(Preferences.IsRtl ? "وضعیت مطالعه" : "Progress")
                                    </button>
                                    @if (b.Status == BookStatus.Available)
                                    {
                                        <button class="btn btn-outline-warning btn-sm text-dark flex-fill" @onclick="() => OpenLoanModal(b)">
                                            🤝 @(Preferences.IsRtl ? "امانت دادن" : "Loan")
                                        </button>
                                    }
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteBook(b.Id)">
                                        🗑️
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <!-- TAB 2: LOANS / WHO HAS WHAT -->
        @if (activeTab == "loans")
        {
            @if (!activeLoans.Any())
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <span style="font-size: 3rem;">🤝</span>
                    <h6 class="mt-2">@(Preferences.IsRtl ? "هیچ کتابی در امانت نیست" : "No active book loans")</h6>
                    <p class="text-muted small">@(Preferences.IsRtl ? "تمام کتاب‌ها در قفسه‌ها حاضر هستند." : "All books are currently on the shelves.")</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var ln in activeLoans)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm p-3 h-100 d-flex flex-column justify-content-between @(ln.IsOverdue ? "border-danger border-start border-4" : "")">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold mb-0">@ln.BookTitle</h6>
                                            <small class="text-muted">@(Preferences.IsRtl ? "امانت‌گیرنده:" : "Borrower:") <strong>@ln.BorrowerName</strong></small>
                                        </div>
                                        @if (ln.IsOverdue)
                                        {
                                            <span class="badge bg-danger">@(Preferences.IsRtl ? "سررسید گذشته!" : "Overdue!")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@(Preferences.IsRtl ? "در دست امانت" : "Active Loan")</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(ln.BorrowerContact))
                                    {
                                        <small class="text-secondary d-block mb-1">
                                            📞 @ln.BorrowerContact
                                        </small>
                                    }

                                    <small class="text-muted d-block mb-1">
                                        📅 @(Preferences.IsRtl ? "تاریخ امانت:" : "Loaned:") @FormatDate(ln.LoanedAt)
                                    </small>
                                    <small class="@(ln.IsOverdue ? "text-danger fw-bold" : "text-muted") d-block mb-3">
                                        ⏳ @(Preferences.IsRtl ? "سررسید بازگشت:" : "Due Date:") @FormatDate(ln.DueAt)
                                    </small>
                                </div>

                                <button class="btn btn-success btn-sm w-100" @onclick="() => ReturnBook(ln.Id)">
                                    ✓ @(Preferences.IsRtl ? "تحویل گرفته شد (بازگشت به قفسه)" : "Mark Returned")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <!-- TAB 3: MOVIES & SERIES -->
        @if (activeTab == "media")
        {
            <div class="card border-0 shadow-sm p-3 mb-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="@(Preferences.IsRtl ? "جستجوی فیلم، سریال، کارگردان..." : "Search title, director...")"
                               @bind="mediaSearch"
                               @bind:event="oninput"
                               @bind:after="FilterMedia" />
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select form-select-sm" @bind="selectedMediaType" @bind:after="FilterMedia">
                            <option value="">-- @(Preferences.IsRtl ? "همه انواع" : "All Types") --</option>
                            <option value="@MediaType.Movie">@(Preferences.IsRtl ? "فیلم سینمایی" : "Movie")</option>
                            <option value="@MediaType.Series">@(Preferences.IsRtl ? "سریال" : "Series")</option>
                            <option value="@MediaType.Anime">@(Preferences.IsRtl ? "انیمه" : "Anime")</option>
                            <option value="@MediaType.Documentary">@(Preferences.IsRtl ? "مستند" : "Documentary")</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select form-select-sm" @bind="selectedWatchStatus" @bind:after="FilterMedia">
                            <option value="">-- @(Preferences.IsRtl ? "همه وضعیت‌های تماشا" : "All Watch Statuses") --</option>
                            <option value="@WatchStatus.PlanToWatch">@(Preferences.IsRtl ? "قصدم تماشا است" : "Plan to Watch")</option>
                            <option value="@WatchStatus.Watching">@(Preferences.IsRtl ? "در حال تماشا" : "Watching")</option>
                            <option value="@WatchStatus.Completed">@(Preferences.IsRtl ? "دیده‌ام (کامل)" : "Completed")</option>
                        </select>
                    </div>
                </div>
            </div>

            @if (!mediaList.Any())
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <span style="font-size: 3rem;">🎬</span>
                    <h6 class="mt-2">@(Preferences.IsRtl ? "موردی یافت نشد" : "No media items found")</h6>
                    <p class="text-muted small">@(Preferences.IsRtl ? "فیلم‌ها و سریال‌های مورد علاقه خود را اضافه کنید." : "Add movies and series to your family watchlist.")</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var m in mediaList)
                    {
                        var userProgress = m.PersonProgresses.FirstOrDefault(p => p.PersonId == selectedPersonId);
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm p-3 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex gap-2 align-items-center">
                                            <span class="fs-3">@(m.Type == MediaType.Movie ? "🎬" : "📺")</span>
                                            <div>
                                                <h6 class="fw-bold mb-0">@m.Title</h6>
                                                <small class="text-muted">@m.ReleaseYear • @m.Director</small>
                                            </div>
                                        </div>
                                        <span class="badge bg-secondary">@m.Type</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(m.Overview))
                                    {
                                        <p class="text-secondary small mb-2 text-truncate" style="max-height: 40px;">@m.Overview</p>
                                    }

                                    <!-- Next to watch banner for series -->
                                    @if (m.Type == MediaType.Series && m.NextToWatch != null)
                                    {
                                        <div class="alert alert-info py-1 px-2 mb-2 small d-flex justify-content-between align-items-center">
                                            <span>▶️ @(Preferences.IsRtl ? "قسمت بعدی:" : "Next to watch:")</span>
                                            <strong>S@(m.NextToWatch.SeasonNumber):E@(m.NextToWatch.EpisodeNumber)</strong>
                                        </div>
                                    }

                                    <!-- User Progress & Rating -->
                                    <div class="bg-light p-2 rounded mb-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <small class="text-muted d-block">@(Preferences.IsRtl ? "وضعیت:" : "Status:")</small>
                                            @if (userProgress != null)
                                            {
                                                <span class="badge @GetWatchStatusBadge(userProgress.WatchStatus)">@GetWatchStatusText(userProgress.WatchStatus)</span>
                                            }
                                            else
                                            {
                                                <small class="text-muted">@(Preferences.IsRtl ? "ثبت نشده" : "Not set")</small>
                                            }
                                        </div>
                                        @if (userProgress?.Rating.HasValue == true)
                                        {
                                            <div class="text-warning fw-bold">
                                                ⭐ @userProgress.Rating.Value/10
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top">
                                    <button class="btn btn-outline-primary btn-sm flex-fill" @onclick="() => OpenSetMediaProgressModal(m)">
                                        👁️ @(Preferences.IsRtl ? "وضعیت تماشا" : "Progress")
                                    </button>
                                    @if (m.Type == MediaType.Series)
                                    {
                                        <button class="btn btn-outline-secondary btn-sm flex-fill" @onclick="() => SelectSeriesForEpisodes(m)">
                                            📺 @(Preferences.IsRtl ? "قسمت‌ها" : "Episodes")
                                        </button>
                                    }
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteMedia(m.Id)">
                                        🗑️
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <!-- TAB 4: EPISODE TRACKER -->
        @if (activeTab == "episodes")
        {
            @if (selectedSeries == null)
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <span style="font-size: 3rem;">📺</span>
                    <h6 class="mt-2">@(Preferences.IsRtl ? "ابتدا سریالی را از تب «فیلم‌ها و سریال‌ها» انتخاب کنید" : "Please select a series from the Media tab first")</h6>
                    <div class="mt-3">
                        <button class="btn btn-primary btn-sm" @onclick='() => activeTab = "media"'>
                            @(Preferences.IsRtl ? "رفتن به لیست فیلم و سریال" : "Go to Media")
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-1">📺 @selectedSeries.Title</h5>
                            <small class="text-muted">
                                @(Preferences.IsRtl ? "تعداد فصل‌ها:" : "Seasons:") @(selectedSeries.SeasonCount ?? 0) •
                                @(Preferences.IsRtl ? "قسمت‌های دیده‌شده:" : "Watched:") @selectedSeriesWatchedCount
                            </small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary btn-sm" @onclick="OpenGenerateEpisodesModal">
                                ⚡ @(Preferences.IsRtl ? "تولید خودکار قسمت‌ها" : "Generate Episodes")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Next to Watch banner -->
                @if (selectedSeriesNextToWatch != null)
                {
                    <div class="alert alert-success d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <strong>▶️ @(Preferences.IsRtl ? "قسمت بعدی برای تماشا:" : "Next to watch:")</strong>
                            <span class="ms-2">فصل @selectedSeriesNextToWatch.SeasonNumber، قسمت @selectedSeriesNextToWatch.EpisodeNumber (@selectedSeriesNextToWatch.Title)</span>
                        </div>
                        <button class="btn btn-sm btn-success" @onclick="() => MarkEpisodeWatched(selectedSeriesNextToWatch.Id, true)">
                            ✓ @(Preferences.IsRtl ? "دیدم!" : "Mark Watched")
                        </button>
                    </div>
                }

                @if (!seriesEpisodes.Any())
                {
                    <div class="card border-0 shadow-sm text-center py-4 text-muted">
                        <small>@(Preferences.IsRtl ? "هیچ قسمتی برای این سریال ثبت نشده است. از دکمه «تولید خودکار قسمت‌ها» استفاده کنید." : "No episodes found. Use Generate Episodes button.")</small>
                    </div>
                }
                else
                {
                    <div class="accordion" id="seasonAccordion">
                        @foreach (var seasonGroup in seriesEpisodes.GroupBy(e => e.SeasonNumber).OrderBy(g => g.Key))
                        {
                            var sNum = seasonGroup.Key;
                            var watchedInSeason = seasonGroup.Count(e => e.IsWatchedByCurrentPerson);
                            <div class="card border-0 shadow-sm mb-2">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                                    <h6 class="fw-bold mb-0">@(Preferences.IsRtl ? $"فصل {sNum}" : $"Season {sNum}")</h6>
                                    <span class="badge bg-light text-dark border">@watchedInSeason / @seasonGroup.Count() @(Preferences.IsRtl ? "دیده شده" : "Watched")</span>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        @foreach (var ep in seasonGroup.OrderBy(e => e.EpisodeNumber))
                                        {
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <input type="checkbox"
                                                           class="form-check-input mt-0"
                                                           checked="@ep.IsWatchedByCurrentPerson"
                                                           @onchange="(e) => MarkEpisodeWatched(ep.Id, (bool)(e.Value ?? false))" />
                                                    <span class="@(ep.IsWatchedByCurrentPerson ? "text-decoration-line-through text-muted" : "fw-bold")">
                                                        @(Preferences.IsRtl ? $"قسمت {ep.EpisodeNumber}" : $"Ep {ep.EpisodeNumber}"): @ep.Title
                                                    </span>
                                                </div>
                                                @if (ep.IsWatchedByCurrentPerson)
                                                {
                                                    <small class="text-success">✓ @(Preferences.IsRtl ? "دیده شده" : "Watched")</small>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
    }
</div>

<!-- MODAL: ADD BOOK -->
@if (showAddBookModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(Preferences.IsRtl ? "افزودن کتاب جدید" : "New Book")</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddBookModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@(Preferences.IsRtl ? "عنوان کتاب" : "Book Title") *</label>
                        <input type="text" class="form-control" @bind="newBookTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@(Preferences.IsRtl ? "نویسنده / پدیدآور" : "Author") *</label>
